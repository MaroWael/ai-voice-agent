PROJECT_NAME=

POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

REDIS_HOST=
REDIS_PORT=

QDRANT_HOST=
QDRANT_HTTP_PORT=

# Language Model (LLM)
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=

# Silma Text-to-Speech (TTS)
SILMA_API_KEY=
SILMA_BASE_URL=
SILMA_MODEL_ID=
SILMA_VOICE_ID=

# Query Optimization
# Set to false to bypass query optimization and pass the raw query to retrieval.
QUERY_OPTIMIZER_ENABLED=true

# Unknown Answer Detection
# Minimum cosine similarity for the top-ranked document (0.0 – 1.0).
UNKNOWN_DETECTOR_MIN_SCORE=0.35
# Minimum number of documents required to consider context sufficient.
UNKNOWN_DETECTOR_MIN_RESULTS=1
# Minimum mean similarity score across all retrieved documents.
UNKNOWN_DETECTOR_MEAN_THRESHOLD=0.30
