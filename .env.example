PROJECT_NAME=

POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

REDIS_HOST=
REDIS_PORT=

QDRANT_HOST=
QDRANT_HTTP_PORT=

# Language Model (LLM Provider Selection: "ollama" | "groq")
LLM_PROVIDER=groq
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:1.7b
LLM_TIMEOUT=180.0
LLM_NUM_PREDICT=150
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.2
LLM_REPEAT_PENALTY=1.1

# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=150


# Silma Text-to-Speech (TTS)
SILMA_API_KEY=
SILMA_BASE_URL=
SILMA_MODEL_ID=
SILMA_VOICE_ID=

# Query Optimization
# Set to false to bypass query optimization and pass the raw query to retrieval.
QUERY_OPTIMIZER_ENABLED=true

# Unknown Answer Detection
# Minimum cosine similarity for the top-ranked document (0.0 – 1.0).
UNKNOWN_DETECTOR_MIN_SCORE=0.35
# Minimum number of documents required to consider context sufficient.
UNKNOWN_DETECTOR_MIN_RESULTS=1
# Minimum mean similarity score across all retrieved documents.
UNKNOWN_DETECTOR_MEAN_THRESHOLD=0.30
